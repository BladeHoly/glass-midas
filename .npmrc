# Native/WASM bindings that pnpm's strict layout hides from the code that loads them:
# - satteri: Astro 7 bundles its Markdown parser into prerender chunks, which then
#   resolve the platform binary from there.
# - @emnapi: peer of @napi-rs/wasm-runtime, needed by `astro check`.
public-hoist-pattern[]=@bruits/satteri-*
public-hoist-pattern[]=@emnapi/*
