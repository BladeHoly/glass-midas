{
  "name": "@glass-midas/core",
  "version": "0.1.1",
  "description": "Framework-agnostic Liquid Glass engine, tokens and primitives",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BladeHoly/glass-midas.git",
    "directory": "packages/core"
  },
  "sizeBudget": {
    "dist/index.js": 4096
  },
  "scripts": {
    "build": "node ../../scripts/clean.mjs && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "node ../../scripts/size.mjs"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  }
}
