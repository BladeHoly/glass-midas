{
  "name": "@glass-midas/react",
  "version": "0.2.0",
  "description": "React bindings for glass-midas: the useGlass hook, <Glass>, and the glass components",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/components.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "default": "./dist/components.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BladeHoly/glass-midas.git",
    "directory": "packages/react"
  },
  "sizeBudget": {
    "dist/index.js": 1024,
    "dist/components.js": 1024
  },
  "scripts": {
    "build": "node ../../scripts/clean.mjs && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "node ../../scripts/size.mjs"
  },
  "dependencies": {
    "@glass-midas/core": "workspace:^"
  },
  "peerDependencies": {
    "@glass-midas/components": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@glass-midas/components": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "@glass-midas/components": {
      "optional": true
    }
  }
}
