{
  "name": "@glass-midas/webgl",
  "version": "0.0.0",
  "description": "WebGL renderer for glass-midas: floating-point optics and dispersion over an explicit backdrop",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "default": "./dist/capture.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BladeHoly/glass-midas.git",
    "directory": "packages/webgl"
  },
  "sizeBudget": {
    "dist/index.js": 4096,
    "dist/capture.js": 1024
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "node ../../scripts/size.mjs"
  },
  "dependencies": {
    "@glass-midas/core": "workspace:^"
  },
  "peerDependencies": {
    "html-to-image": ">=1.11"
  },
  "peerDependenciesMeta": {
    "html-to-image": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "html-to-image": "^1.11.13"
  }
}
