---
interface Member {
  name: string;
  type?: string;
  default?: string;
  description: string;
}
interface Props {
  title: string;
  rows: Member[];
}
const { title, rows } = Astro.props;
const id = title.toLowerCase();
---

{
  rows.length > 0 && (
    <section>
      <h2 id={id}>{title}</h2>
      <div class="table">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Type</th>
              <th>Default</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>
                  <code>{r.name}</code>
                </td>
                <td>{r.type && <code>{r.type}</code>}</td>
                <td>{r.default && <code>{r.default}</code>}</td>
                <td>{r.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
