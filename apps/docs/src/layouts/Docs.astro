---
import { tokensToCss } from '@glass-midas/core';
import '@glass-midas/components/styles.css';
import '../styles/site.css';
import { docPath, readingOrder, sidebar, url } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** A landing page: no sidebars. */
  splash?: boolean;
  /** The page's Markdown twin, for agents. */
  markdown?: string;
}

const { title, description, splash = false, markdown } = Astro.props;
const sections = await sidebar();
const here = Astro.url.pathname;
const pages = (await readingOrder()).map((d) => ({
  label: d.data.title,
  href: url(docPath(d)),
  hint: d.data.description,
}));
const fullTitle = title === 'glass-midas' ? title : `${title} · glass-midas`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Before the first paint, so the page never flashes the other theme: the saved choice,
      // else the system's.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('gm-theme');
        } catch {}
        const light = saved ? saved === 'light' : matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.dataset.theme = light ? 'light' : 'dark';
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..900&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <style is:inline set:html={tokensToCss()}></style>
  </head>
  <body class:list={[splash && 'is-splash']}>
    <div class="backdrop" aria-hidden="true">
      <span class="blob gold"></span>
      <span class="blob teal"></span>
      <span class="blob ember"></span>
      <span class="blob violet"></span>
    </div>

    <header class="topbar">
      <a class="brand" href={url('/')}>glass<em>midas</em></a>
      <gm-search
        material="frost"
        hotkey="k"
        placeholder="Search the docs"
        label="Search the docs"
      ></gm-search>
      <div class="top-actions">
        <nav class="top-links" aria-label="Project">
          <a href={url('/llms.txt')}>llms.txt</a>
          <a href="https://github.com/BladeHoly/glass-midas">GitHub</a>
        </nav>
        <button class="theme" type="button" aria-label="Switch to light theme">
          <svg
            class="moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg
          >
          <svg
            class="sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path></svg
          >
        </button>
        {
          !splash && (
            <button
              class="menu"
              type="button"
              aria-label="Menu"
              aria-expanded="false"
              aria-controls="sidebar"
            >
              <span />
              <span />
              <span />
            </button>
          )
        }
      </div>
    </header>

    <div class="shell">
      {
        !splash && (
          <aside class="sidebar" id="sidebar">
            <gm-nav orientation="vertical" variant="lite" aria-label="Documentation">
              {sections.map((s) => (
                <div class="nav-group">
                  <p>{s.label}</p>
                  {s.docs.map((d) => {
                    const href = url(docPath(d));
                    return (
                      <a href={href} aria-current={href === here ? 'page' : undefined}>
                        {d.data.label ?? d.data.title}
                      </a>
                    );
                  })}
                </div>
              ))}
            </gm-nav>
          </aside>
        )
      }

      <main class="content" id="content" data-pagefind-body>
        <slot />
      </main>

    </div>

    <gm-scrollbar></gm-scrollbar>
    <script type="application/json" id="gm-pages" set:html={JSON.stringify(pages)} />
    <script>
      import { toast } from '@glass-midas/components';
      import { setupSearch } from '../lib/search';

      setupSearch();
      // Demos are plain HTML and can't import the package: they reach toast() here.
      (window as unknown as { glassMidas: object }).glassMidas = { toast };

      // On narrow screens the search box says just "Search".
      const narrow = matchMedia('(max-width: 56rem)');
      const placeholder = () => {
        const input = document.querySelector<HTMLInputElement>('.topbar gm-search input');
        if (input) input.placeholder = narrow.matches ? 'Search' : 'Search the docs';
      };
      placeholder();
      narrow.addEventListener('change', placeholder);

      // Theme switch: saves the choice; without one, the page follows the system as it changes.
      const root = document.documentElement;
      const themeButton = document.querySelector<HTMLButtonElement>('.theme')!;
      const label = () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        themeButton.setAttribute('aria-label', `Switch to ${next} theme`);
      };
      label();
      themeButton.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
        try {
          localStorage.setItem('gm-theme', root.dataset.theme);
        } catch {}
        label();
      });
      matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
        let saved = null;
        try {
          saved = localStorage.getItem('gm-theme');
        } catch {}
        if (saved) return;
        root.dataset.theme = e.matches ? 'light' : 'dark';
        label();
      });

      // The sidebar becomes a drawer on narrow screens.
      const menu = document.querySelector<HTMLButtonElement>('.menu');
      const setOpen = (open: boolean) => {
        document.body.classList.toggle('nav-open', open);
        menu?.setAttribute('aria-expanded', String(open));
      };
      menu?.addEventListener('click', () => setOpen(!document.body.classList.contains('nav-open')));
      addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
      addEventListener('click', (e) => {
        const target = e.target as Element;
        if (!target.closest('.sidebar, .menu')) setOpen(false);
      });
    </script>
  </body>
</html>
