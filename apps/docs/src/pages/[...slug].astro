---
import { getCollection, render } from 'astro:content';
import { mdxComponents } from '../components/mdx';
import MemberTable from '../components/mdx/MemberTable.astro';
import Docs from '../layouts/Docs.astro';
import { docPath, readingOrder, url, type Doc } from '../lib/site';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props as { doc: Doc };
const { Content, headings } = await render(doc);
const { title, description, element, attributes, properties, events, methods } = doc.data;
const api = attributes.length + properties.length + events.length + methods.length > 0;

const order = await readingOrder();
const i = order.findIndex((d) => d.id === doc.id);
const prev = order[i - 1];
const next = order[i + 1];
const markdown = url(`/${doc.id}.md`);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const source = `https://github.com/BladeHoly/glass-midas/blob/main/apps/docs/src/content/docs/${doc.id}.mdx`;
---

<Docs title={title} description={description} markdown={markdown}>
  <article class="article">
    <div class="article-main">
    <header class="page-head">
      {element && <p class="element">&lt;{element}&gt;</p>}
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="page-links" data-pagefind-ignore>
        <button type="button" class="gm-chip copy-page" data-markdown={markdown}>Copy page</button>
        <a class="gm-chip gm-chip-plain" href={markdown}>View as Markdown</a>
        <a class="gm-chip gm-chip-plain" href={source}>Edit on GitHub</a>
      </p>
    </header>

    {
      api ? (
        <gm-tabs class="page-tabs">
          <gm-tab label="Overview">
            <Content components={mdxComponents} />
          </gm-tab>
          <gm-tab label="API">
            <MemberTable title="Attributes" rows={attributes} />
            <MemberTable title="Properties" rows={properties} />
            <MemberTable title="Events" rows={events} />
            <MemberTable title="Methods" rows={methods} />
          </gm-tab>
        </gm-tabs>
      ) : (
        <Content components={mdxComponents} />
      )
    }

    <nav class="pager" aria-label="Pages" data-pagefind-ignore>
      {
        prev && (
          <a href={url(docPath(prev))} rel="prev">
            <small>Previous</small>
            {prev.data.title}
          </a>
        )
      }
      {
        next && (
          <a href={url(docPath(next))} rel="next" class="next">
            <small>Next</small>
            {next.data.title}
          </a>
        )
      }
    </nav>
    </div>

    <!-- The right rail: where you are on the page, and the code that goes with it. -->
    <aside class="rail" aria-label="On this page" data-pagefind-ignore>
      {
        toc.length > 1 && (
          <div class="rail-toc">
            <p>On this page</p>
            <gm-nav orientation="vertical" variant="lite" spy>
              {toc.map((h) => (
                <a href={`#${h.slug}`} class:list={[h.depth === 3 && 'is-sub']}>
                  {h.text}
                </a>
              ))}
            </gm-nav>
          </div>
        )
      }
      <div class="rail-code"></div>
    </aside>
  </article>
  <script is:inline>
    // Wide screens: the page's code panels move into the rail, beside the prose; narrow ones put
    // them back where they were written. Inline, so they move before the first paint.
    (() => {
      const rail = document.querySelector('.rail-code');
      const panels = [...document.querySelectorAll('.code-panel[data-rail]')];
      if (!rail || !panels.length) return;
      const homes = panels.map((p) => {
        const mark = document.createComment('code-panel');
        p.before(mark);
        return mark;
      });
      const wide = matchMedia('(min-width: 80rem)');
      const place = () => {
        panels.forEach((p, i) => (wide.matches ? rail.append(p) : homes[i].after(p)));
        document.documentElement.classList.toggle('has-rail-code', wide.matches);
      };
      place();
      wide.addEventListener('change', place);
    })();
  </script>
</Docs>

<script>
  // Copies the page's Markdown twin, ready to paste into an agent. The clipboard gets a promise
  // of the text, so the copy stays tied to the click while the file loads (Safari needs that).
  const button = document.querySelector<HTMLButtonElement>('.copy-page');
  button?.addEventListener('click', async () => {
    const text = fetch(button.dataset.markdown!).then((r) => r.text());
    try {
      await navigator.clipboard.write([
        new ClipboardItem({ 'text/plain': text.then((t) => new Blob([t], { type: 'text/plain' })) }),
      ]);
    } catch {
      await navigator.clipboard.writeText(await text);
    }
    button.textContent = 'Copied';
    setTimeout(() => (button.textContent = 'Copy page'), 1600);
  });
</script>
